{
  "name": "@heatseeker/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Типизированный клиент API ядра: типы из OpenAPI + openapi-fetch с авторизацией и refresh",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@heatseeker/config": "workspace:*",
    "eslint": "^10.0.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
