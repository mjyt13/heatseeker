# Heatseeker — переменные окружения ядра (apps/api).
# Скопировать в .env и заполнить. .env никогда не коммитится.
# Секреты генерировать так: openssl rand -base64 48

# ---------- App ----------
APP_ENV=dev                          # dev | prod
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173  # в dev localhost и локальная сеть разрешены всегда
LOG_LEVEL=debug                      # debug | info | warn | error
APP_ENCRYPTION_KEY=                  # AES-GCM ключ (base64, 32 байта) для шифрования токенов в БД
TRUSTED_PROXY_COUNT=0                # сколько реверс-прокси перед API: 0 локально, 1 — за Caddy (X-Forwarded-For)

# ---------- Database / Redis / jobs ----------
DATABASE_URL=postgres://heatseeker:heatseeker@localhost:5433/heatseeker?sslmode=disable   # 5433 — см. infra/compose/docker-compose.dev.yml
TEST_DATABASE_URL=postgres://heatseeker:heatseeker@localhost:5433/heatseeker_test?sslmode=disable   # только интеграционные тесты; база создаётся infra/compose/postgres-init
DB_MAX_CONNS=10
REDIS_URL=redis://localhost:6379/0
JOBS_CONCURRENCY=8
JOBS_QUEUES=critical:6,default:3,low:1
EVENT_LOG_RETENTION_DAYS=90          # ретеншен group_events; старше — полный ресинк клиента

# ---------- Auth ----------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=180
REFRESH_TOKEN_PEPPER=
GOOGLE_OAUTH_CLIENT_ID=              # OAuth-клиент «Web application»: проверка id_token и подключение аккаунта для публикации на Диск (D34)
GOOGLE_OAUTH_CLIENT_SECRET=          # секрет того же клиента; вместе с ID включает подключение аккаунта (нужен APP_ENCRYPTION_KEY)
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
AUTH_REQUIRE_SECURED_FOR=admin,moderation,headman,drive_upload   # действия, требующие уровня L2
GROUP_DEFAULT_JOIN_POLICY=open       # open | invite (approval — в будущих версиях)
PUBLIC_READ_ENABLED=false            # L0: публичное чтение без аккаунта (переключатель, по умолчанию выкл.)
INVITE_DEFAULT_TTL_DAYS=30

# ---------- Media ----------
MEDIA_MODE_DEFAULT=cache             # link | cache | import (дефолт для новых групп)
MEDIA_PROXY_ENABLED=true             # прокси-стрим файлов с Google Диска через сервисный аккаунт
MEDIA_CACHE_TTL_HOURS=168            # TTL копии в S3 в режиме cache (продлевается при обращении)
MEDIA_CACHE_MAX_GB=20                # лимит кеша на группу; вытеснение LRU
MEDIA_CACHE_PREFETCH_MAX_MB=25       # файлы меньше — кешировать заранее при индексации
MEDIA_IMPORT_MAX_MB=500
STORAGE_DRIVER=s3                    # s3 | local (local — файлы идут через API по подписанным ссылкам)
STORAGE_LOCAL_ROOT=/var/lib/heatseeker/media
S3_ENDPOINT=http://localhost:9100          # 9100 — см. infra/compose/docker-compose.dev.yml
S3_PUBLIC_ENDPOINT=http://localhost:9100   # origin, доступный клиентам (для presigned URL)
S3_REGION=us-east-1
S3_BUCKET=heatseeker-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SEC=900
TMP_UPLOAD_TTL_HOURS=24
UPLOAD_MAX_SIZE_MB=200
UPLOAD_MULTIPART_THRESHOLD_MB=50
UPLOAD_ALLOWED_EXT=pdf,doc,docx,ppt,pptx,xls,xlsx,rtf,odt,odp,ods,txt,md,csv,png,jpg,jpeg,webp,heic,zip,mp3,m4a,ogg,flac,wav,mp4,mov,webm,mkv
MATERIAL_HARD_DELETE_AFTER_DAYS=30   # удалённые материалы и их файлы стираются через N дней
MATERIAL_HASH_MAX_MB=500             # sha256 загрузок считается для файлов не больше N МБ
MEDIA_STREAM_TOKEN_TTL_MIN=60        # срок жизни ссылки на просмотр файла с Диска через сервер
OFFICE_PREVIEW_URL=                  # Gotenberg для PDF-превью pptx/docx/xlsx (dev: http://localhost:3030); пусто — офисные файлы только скачиваются
OFFICE_PREVIEW_MAX_MB=50             # файлы больше не конвертируются
TEXT_EXTRACT_ENABLED=true
PREVIEW_OFFICE_ENABLED=false         # превью офисных файлов через LibreOffice headless (ресурсоёмко)
AV_ENABLED=false                     # ClamAV (clamd) — включать при наличии ~1.2 GB RAM
CLAMD_ADDR=clamav:3310
AV_MAX_FILE_MB=100

# ---------- Google Drive (сервисный аккаунт) ----------
GDRIVE_SERVICE_ACCOUNT_JSON_BASE64=  # base64 от JSON-ключа сервисного аккаунта (docs/GOOGLE-DRIVE.md); пусто — Диск выключен
GDRIVE_SYNC_INTERVAL_SEC=600
GDRIVE_FULL_RESCAN_INTERVAL_SEC=86400
GDRIVE_EXPORT_FORMATS=pdf            # во что экспортировать нативные Google Docs/Sheets/Slides
GDRIVE_CLASSIFY_MIN_CONFIDENCE=0.6   # ниже — в Inbox «Неразобранное»
GDRIVE_DELETE_POLICY=flag            # flag | archive — что делать, если файл исчез с Диска
FEATURE_DRIVE_UPLOAD=false           # публикация загрузок на Диск (D32): от подключённого аккаунта старосты (D34), иначе SA — только в Shared Drive
GDRIVE_OAUTH_REDIRECT_URL=           # куда Google вернёт после входа; пусто — http://localhost:APP_PORT/api/v1/drive/oauth/callback в dev, APP_BASE_URL/… в проде

# ---------- Notifications ----------
PUSH_PROVIDER=expo                   # expo | none
EXPO_ACCESS_TOKEN=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com
EMAIL_ENABLED=false
SMTP_URL=
EMAIL_FROM=Heatseeker <noreply@example.com>
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
DEADLINE_REMINDER_OFFSETS=7d,3d,1d,3h
NOTIFY_MATERIAL_BATCH_WINDOW_SEC=600 # окно склейки «N новых материалов по предмету»
QUIET_HOURS_DEFAULT=23:00-08:00
DPO_NOTIFICATIONS_DEFAULT=off        # для групп kind=DPO уведомления по умолчанию выключены

# ---------- Realtime (после MVP) ----------
WS_ENABLED=false
WS_FANOUT=inproc                     # inproc | redis
WS_HEARTBEAT_SEC=25

# ---------- AI service link (этап 2) ----------
AI_ENABLED=false
AI_SERVICE_URL=http://localhost:8090
AI_SERVICE_TOKEN=                    # сервисный токен для /internal/ai/*

# ---------- Feature flags ----------
FEATURE_PROPOSALS=true
FEATURE_MARKDOWN=true
FEATURE_TELEGRAM=false
FEATURE_PUBLIC_READ=false

# ---------- Mobile (Expo; EXPO_PUBLIC_* попадают в бандл — только публичные значения) ----------
EXPO_PUBLIC_API_URL=                # пусто — в dev хост Metro/страницы, порт 8000 (apps/mobile/src/lib/api.ts)
EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=

